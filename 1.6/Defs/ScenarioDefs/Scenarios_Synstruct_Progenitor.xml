<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ScenarioDef ParentName="ScenarioBase">
		<defName>ABF_Scenario_Synstruct_Progenitor</defName>
		<label>Synstruct Progenitor</label>
		<description>You are a synthetic being (specifically a Jellyman), created to explore and settle new worlds. You live to spread synthetic life across the galaxy, although the specifics are up to you. Will you embrace organic lifeforms or view them as inferior?</description>
		<scenario>
			<summary>A single synstruct progenitor unit, with a few extra items to get started.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>ABF_Faction_Synstruct_Player_Progenitor</factionDef>
			</playerFaction>
			<parts>
				<!-- Config pages -->
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnCount>1</pawnCount>
				</li>
				<!-- Player starting stuff spawn method-->
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>DropPods</method>
					<visible>true</visible>
				</li>
				<li MayRequire="Killathon.ArtificialBeings.SynCore.Biomimetics" Class="ScenPart_StartingAnimal">
					<def>StartingAnimal</def>
                    <count>2</count>
                    <animalKind>ABF_PawnKind_Synstruct_Chemstruct_Newboot</animalKind>
				</li>
				<!-- Player starting things -->
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>Steel</thingDef>
					<count>300</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ABF_Thing_Synstruct_RepairStim</thingDef>
					<count>10</count>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ComponentIndustrial</thingDef>
					<count>30</count>
				</li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Gun_BoltActionRifle</thingDef>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Gun_Revolver</thingDef>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MeleeWeapon_Knife</thingDef>
                    <stuff>Plasteel</stuff>
                </li>
				<li Class="ScenPart_StartingThing_Defined">
					<def>StartingThing_Defined</def>
					<thingDef>ABF_Thing_Synstruct_PartPack</thingDef>
					<count>10</count>
				</li>
				<!-- Scatter some things near player start -->
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Steel</thingDef>
					<count>450</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Plasteel</thingDef>
					<count>180</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>WoodLog</thingDef>
					<count>300</count>
				</li>
				<li Class="ScenPart_ScatterThingsNearPlayerStart">
					<def>ScatterThingsNearPlayerStart</def>
					<thingDef>Chemfuel</thingDef>
					<count>90</count>
				</li>
				<!-- Scatter some things anywhere -->
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>ShipChunk</thingDef>
					<count>5</count>
				</li>
				<li Class="ScenPart_ScatterThingsAnywhere">
					<def>ScatterThingsAnywhere</def>
					<thingDef>Steel</thingDef>
					<count>720</count>
				</li>
				<!-- Game start dialog -->
				<li Class="ScenPart_GameStartDialog">
					<def>GameStartDialog</def>
					<text>The landing site is marked by organic life and broken ship parts. A life-sustaining planet. If life can survive here, so can you. This world will do.</text>
					<closeSound>GameStartSting</closeSound>
				</li>
			</parts>
		</scenario>
	</ScenarioDef>

</Defs>